{
  "name": "Concept Animation (30-45s)",
  "description": "Math or science explainer with continuous transformation (Manim-heavy). Structure: Hook / Visual build / Reveal / Takeaway",
  "format": {
    "preset": "reel_9x16",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_zone": { "top": 0.14, "bottom": 0.35, "side": 0.06 },
    "center_crop_check": "3:4"
  },
  "duration": { "target_s": 40, "min_s": 30, "max_s": 50 },
  "pacing": {
    "preset": "balanced",
    "hook_deadline_s": 1.0,
    "hook_complete_s": 3.0,
    "change_interval_s": [2.0, 4.0],
    "max_static_s": 3.5
  },
  "style": {
    "preset": "clean_dark",
    "palette": ["#000000", "#ECEEDF", "#5CD0B3", "#58C4DD", "#FFFF00"],
    "fonts": { "display": "CMU Serif", "body": "Inter" },
    "motion": "smooth"
  },
  "captions": {
    "mode": "minimal",
    "max_words": 6,
    "position": "upper_mid",
    "highlight": "keyword",
    "reading_speed_cps": 16
  },
  "transitions": {
    "allowed": ["hard_cut", "morph", "match_cut"],
    "max_heavy_per_10s": 1
  },
  "audio": {
    "input_source": "both",
    "loudness_lufs": -14,
    "duck_music_db": -14,
    "tighten_pauses_s": 0.40,
    "lead_frames": 4,
    "voice_id": "af_heart"
  },
  "export": {
    "draft": "540x960@24",
    "final": "1080x1920@30",
    "codec": "h264",
    "encoder": "h264_nvenc",
    "hardware_acceleration": true,
    "container": "mp4"
  }
}
